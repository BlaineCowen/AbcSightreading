# The in-app Feedback button. Unset FEEDBACK_TO and the button does not appear,
# which is the right default: a button that cannot send anything is worse than
# no button.
#
# The panel POSTs its report to /api/feedback and the SERVER sends the email, so
# neither of these reaches the browser and the address cannot be scraped off the
# page. It also means a tester needs no mail client of their own - the button
# used to hand the report to a mailto: link, which on a machine without desktop
# mail does nothing at all and says nothing about it.
#
# Local: copy this file to .env. Without RESEND_API_KEY the endpoint answers 503
# and the panel shows the report for copying, which is the path to exercise when
# changing that fallback.
FEEDBACK_TO=
# From the Resend integration: vercel integration add resend/resend-email
RESEND_API_KEY=
# Optional. The verified Resend sending identity; defaults to the one in
# src/pages/api/feedback.ts.
FEEDBACK_FROM=

# ── Accounts (src/lib/server/auth.ts) ────────────────────────────────────────
# Postgres for accounts and saved presets. The Prisma Postgres integration on
# Vercel sets this; locally, copy it from `vercel env pull`.
DATABASE_URL=
# Signs session cookies and tokens. Generate with: openssl rand -base64 32
# Use a different value in each environment; changing it signs everyone out.
BETTER_AUTH_SECRET=
# Optional. The site's own URL, for links in emails and the Google callback.
# Unset, it is worked out from Vercel's variables (the production domain, or a
# preview's branch alias) and falls back to http://localhost:4321.
BETTER_AUTH_URL=
# Optional. "Continue with Google" appears only when both are set. From a Web
# OAuth client in Google Cloud Console; register each site's
# <url>/api/auth/callback/google as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Sender for reset and confirmation emails (uses RESEND_API_KEY).
AUTH_EMAIL_FROM=
