---
import Layout from "../layouts/Layout.astro";
import NotFound from "../components/NotFound.astro";

/**
 * Any address the site does not have. Without this page Vercel showed its own
 * "404: NOT_FOUND" with a request id and no way back to the site.
 */
Astro.response.status = 404;
---

<Layout title="Page not found | abc Sight Reading" description="That page does not exist." noindex themable>
  <NotFound />
</Layout>
