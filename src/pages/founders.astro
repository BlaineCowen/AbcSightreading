---
import Layout from "../layouts/Layout.astro";
import FoundersJoin from "../components/FoundersJoin.svelte";
import { FOUNDER_DISCOUNT, FOUNDER_SEATS, FOUNDERS_CLOSE_DEFAULT } from "../lib/founders";
import { serverEnv } from "../lib/server/env";
import { founderCount, open } from "../lib/server/founders";

/**
 * Founding teachers (src/lib/founders.ts): the offer and its Join button.
 * Public and indexed, so it can be shared in a directors' group.
 */
const isOpen = open();
const close = serverEnv("FOUNDERS_CLOSE") ?? FOUNDERS_CLOSE_DEFAULT;
const closeDay = new Date(`${close}T12:00:00Z`).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" });
const joined = await founderCount().catch(() => 0);
const price = (99 * (100 - FOUNDER_DISCOUNT)) / 100;

const gets = [
  { title: "Educator, free this school year", body: "Classes with join codes, assignments, and each student's practice time. Free through May 31, 2027. No card." },
  { title: `${FOUNDER_SEATS} student accounts`, body: "Safe for every age: no student email, logins you can print for your class, no ads or tracking on student pages." },
  { title: `${FOUNDER_DISCOUNT}% off, for as long as you stay`, body: `After May, Educator is $${price.toFixed(2)} a year instead of $99, every year you renew. Nothing is charged when the free year ends: you choose whether to keep it.` },
];
---

<Layout
  title="Founding teachers: Educator free this school year | abcSightReading"
  description={`Choir and ensemble directors: join as a founding teacher and get abcSightReading's Educator plan free through May 2027, ${FOUNDER_SEATS} student accounts, and ${FOUNDER_DISCOUNT}% off after that.`}
  themable
>
  <div class="max-w-4xl mx-auto px-2 flex flex-col gap-10 pb-12">
    <header class="text-center flex flex-col items-center gap-4 pt-4">
      <span class="rounded-full bg-sr-mint text-sr-mint-ink text-xs font-extrabold uppercase tracking-wide px-3 py-1">
        {isOpen ? `Open until ${closeDay}` : "Closed"}
      </span>
      <h1 class="text-4xl md:text-5xl font-bold text-sr-ink text-balance">Be a founding teacher</h1>
      <p class="text-lg text-sr-ink-2 max-w-2xl">
        abcSightReading is new, and built by a Texas choir director. Bring your students onto it this year, tell us what works,
        and you keep a founder's price for good.
      </p>
      <FoundersJoin client:only="svelte" />
      {joined > 4 && <p class="text-sm text-sr-muted">{joined} directors have joined so far.</p>}
    </header>

    <div class="sr-pastels grid grid-cols-1 md:grid-cols-3 gap-4">
      {gets.map((g) => (
        <div class="sr-panel p-6 flex flex-col gap-2">
          <h2 class="text-lg font-semibold text-sr-ink">{g.title}</h2>
          <p class="text-sm text-sr-ink-2">{g.body}</p>
        </div>
      ))}
    </div>

    <section class="max-w-3xl mx-auto text-sr-ink-2 flex flex-col gap-3">
      <h2 class="text-2xl font-semibold text-sr-ink">What we ask</h2>
      <p>
        Use it with your classes, and tell us what is missing or wrong: the Feedback button is on every page, or write to
        support@abc-sightreading.com. If it helps your students, a sentence we can quote, or a word to the directors in your
        region, goes a long way.
      </p>
      <h2 class="text-2xl font-semibold text-sr-ink mt-4">The fine print</h2>
      <ul class="list-disc pl-5 flex flex-col gap-1">
        <li>For teachers, one account each. Sign up with your school email, or through your district's ClassLink, and you join at once; with a personal email, tell us your school and we check first, usually within a day.</li>
        <li>Educator and the {FOUNDER_SEATS} seats end on May 31, 2027. Your classes and students stay; we remind you before then.</li>
        <li>The {FOUNDER_DISCOUNT}% off applies to Educator bought with a card on this account, and stays while it renews.</li>
        <li>Join by {closeDay}.</li>
      </ul>
    </section>
  </div>
</Layout>
