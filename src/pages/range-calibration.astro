---
import Layout from "../layouts/Layout.astro";
import RangeCalibrationForm from "../components/RangeCalibration.svelte";
import NotFound from "../components/NotFound.astro";
import { currentUser } from "../lib/server/api";
import { isAdmin } from "../lib/server/admin";

// A working tool, not a page for visitors: open on the dev server and to the
// owner, a 404 to everyone else.
const allowed = import.meta.env.DEV || isAdmin(await currentUser(Astro.request).catch(() => null));
if (!allowed) Astro.response.status = 404;
---

<Layout noindex title={allowed ? "Range Calibration | abcSightReading" : "Page not found | abcSightReading"} themable={!allowed}>
  {!allowed ? <NotFound /> : (
  <div class="flex flex-col w-full h-full items-center justify-center">
    <h1 class="text-4xl font-bold mb-8">Voice Range Calibration</h1>
    <RangeCalibrationForm client:only="svelte" />
  </div>
  )}
</Layout>
