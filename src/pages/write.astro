---
import Layout from "../layouts/Layout.astro";
import AbcWriter from "../components/AbcWriter.svelte";

/**
 * Hand-write ABC with the score beside it, and save it into `scores/`.
 *
 * Not linked from anywhere. The navbar hardcodes its two links rather than
 * enumerating this directory, which is how /rhythm-game and /range-calibration
 * are already unlisted - this follows that, it does not invent anything. There
 * is no login: the save endpoint only works on the local dev server, so there
 * is nothing on the deployed site for a stranger to find but an ABC scratchpad.
 */
---

<Layout title="Write" description="Transcribe a score as ABC and save it.">
  <div class="flex flex-col w-full items-center">
    <h1 class="text-3xl font-bold mb-2">Write</h1>
    <p class="text-sm text-slate-500 mb-6">
      Type an example as ABC, watch it engrave, and save it into the project.
    </p>
    <AbcWriter client:only="svelte" />
  </div>
</Layout>
