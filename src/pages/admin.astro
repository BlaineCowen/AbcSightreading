---
import Layout from "../layouts/Layout.astro";
import AdminPanel from "../components/AdminPanel.svelte";
import { currentUser } from "../lib/server/api";
import { isAdmin } from "../lib/server/admin";

// The owner's page: access codes and affiliate codes. Anyone else gets a 404,
// so it does not advertise that it exists.
const user = await currentUser(Astro.request).catch(() => null);
if (!isAdmin(user)) return new Response("Not found", { status: 404 });
const origin = new URL(Astro.request.url).origin;
---

<Layout noindex title="Admin - abc Sight Reading" themable>
  <div class="flex flex-col w-full items-center gap-6 pb-16">
    <h1 class="text-3xl font-bold text-sr-ink">Codes</h1>
    <AdminPanel client:only="svelte" {origin} />
  </div>
</Layout>
