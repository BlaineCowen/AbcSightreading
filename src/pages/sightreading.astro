---
import Layout from "../layouts/Layout.astro";
import AbcjsSingle from "../components/AbcjsSingle.svelte";
import AppSkeleton from "../components/ui/AppSkeleton.astro";
---

<Layout
  title="Sight-Singing Practice - Solfège & Rhythm Exercises | abc Sight Reading"
  description="Unlimited single-line sight-singing exercises on the scale degrees and rhythms you choose, with solfège, Kodály rhythm syllables, a step-by-step path from ta and ti-ti, and playback."
  themable
>
  <div class="flex flex-col w-full h-full items-center justify-center">
    <h1 class="text-4xl font-bold mb-2">Single Part Sight Reading</h1>
    <p class="text-sr-muted text-sm mb-6 text-center max-w-xl">
      One line to sight-sing, on the notes and rhythms you choose - from do-re-mi to the full scale.
    </p>
    <AbcjsSingle client:only="svelte">
      <AppSkeleton slot="fallback" staves={1} rows={3} />
    </AbcjsSingle>
  </div>

  <section class="max-w-3xl mx-auto mt-16 text-sr-ink-2 flex flex-col gap-3 no-print">
    <h2 class="text-2xl font-semibold text-sr-ink">Sight-singing, one step at a time</h2>
    <p>
      Choose the scale degrees your singers know - do-re-mi, then up to so, then the whole scale - the rhythms they
      read, and how far a line may leap. Every exercise is new and ends on do. Show movable-do solfège under the notes,
      and Kodály rhythm syllables (ta, ti-ti, or the words your choir already uses).
    </p>
    <p>
      Not sure where to start? <strong>Step by step</strong> goes from rhythm alone, through a single line, to two,
      three and four parts - one new thing at a time. Rhythm-only drills and a count-in make it work for a whole class
      or a student practising at home.
    </p>
    <p>
      Ready for parts? <a class="underline text-sr-action-fg" href="/choral-sightreading">Choral sight-reading</a> writes
      SATB, SSA and TTB exercises.
    </p>
  </section>
</Layout>
