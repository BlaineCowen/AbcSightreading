---
import Layout from "../layouts/Layout.astro";
import AbcjsSingle from "../components/AbcjsSingle.svelte";
import AppSkeleton from "../components/ui/AppSkeleton.astro";
---

<Layout
  title="Sight-Singing Practice: Solfège & Rhythm Exercises | abcSightReading"
  description="Unlimited single-line sight-singing exercises on the scale degrees and rhythms you choose, with solfège, Kodály rhythm syllables, the abcStepByStep path from ta and ti-ti, and playback."
  themable
>
  <div class="flex flex-col w-full h-full items-center justify-center">
    <h1 class="text-4xl font-bold mb-2">Unison Sight Reading Practice</h1>
    <p class="text-sr-muted text-sm mb-6 text-center max-w-xl">
      One line to sight-sing, on the notes and rhythms you choose, from do-re-mi to the full scale.
    </p>
    <AbcjsSingle client:only="svelte">
      <AppSkeleton slot="fallback" staves={1} rows={3} />
    </AbcjsSingle>
  </div>

</Layout>
