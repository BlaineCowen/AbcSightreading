---
import Layout from "../../layouts/Layout.astro";
import InstrumentIcon from "../../components/InstrumentIcon.astro";
import TrackSubscribe from "../../components/TrackSubscribe.svelte";
import { FAMILIES, TRACKS, TRACK_COLOR_CLASS, iconFor, soundsLabel, trackHref, trackKeys, trackReach } from "../../lib/curriculum/tracks";
import { BUILTIN_SETS } from "../../lib/curriculum/catalogue";
import { RHYTHM_LEAD, RHYTHM_THREAD } from "../../lib/curriculum/band";

/**
 * The curriculum catalogue: everything the preset menu can list, and
 * subscribing to it (TrackSubscribe, /api/tracks). The site's own sets are
 * free; the instrument tracks are Pro. Public, so a teacher can read a track
 * before paying.
 */
const band = TRACKS.filter((t) => t.family === "band");
const orchestra = TRACKS.filter((t) => t.family === "strings");
const groups = [
  { id: "band", title: "Beginning band", note: "Every instrument takes the same step on the same day, in the same concert key, so the whole band can read together.", tracks: band },
  { id: "strings", title: "Beginning orchestra", note: "The same rhythm steps, with the notes in string order: D major around the open strings, then G, A, C and F.", tracks: orchestra },
];
// The lag, drawn: the first six steps, rhythm and notes side by side.
const demo = band[0].steps.slice(0, 6);
---

<Layout
  title="Curriculum Tracks | Choir, Band and Orchestra Sight Reading"
  description="Choose the sight-reading sequences you teach from: abcStepByStep, UIL and NYSSMA Voice levels, and step by step tracks for every beginning band and orchestra instrument. Subscribe and they appear in your presets."
  themable
>
  <div class="max-w-6xl mx-auto px-4 pb-16 flex flex-col gap-10">
    <!-- Hero -->
    <section class="sr-panel bg-sr-raise p-6 sm:p-10 flex flex-col gap-5 overflow-hidden relative">
      <p class="text-xs font-extrabold uppercase tracking-widest text-sr-action-fg">Curriculum tracks</p>
      <h1 class="font-display text-3xl sm:text-5xl font-bold text-sr-ink max-w-3xl leading-tight">
        A sequence for every instrument, ready to teach.
      </h1>
      <p class="text-lg text-sr-ink-2 max-w-2xl">
        Your preset menu lists what you subscribe to here, so it holds only what you teach from. An instrument track
        sets up each step for the instrument: its sound, its transposition, its clef and a range a first-year player
        can reach. Change any step and keep it as your version.
      </p>
      <ul class="flex flex-wrap gap-2 text-sm font-bold">
        <li class="rounded-full bg-sr-mint text-sr-mint-ink px-3.5 py-1.5">Rhythm first, always {RHYTHM_LEAD} steps ahead</li>
        <li class="rounded-full bg-sr-sky text-sr-sky-ink px-3.5 py-1.5">Concert B♭, E♭, F, C: the whole band together</li>
        <li class="rounded-full bg-sr-butter text-sr-butter-ink px-3.5 py-1.5">{RHYTHM_THREAD.length} steps, rhythm drill plus notes</li>
      </ul>
    </section>

    <!-- Families -->
    <nav aria-label="Track families" class="flex flex-wrap gap-2 -mb-4">
      {FAMILIES.map((f) => (
        f.live ? (
          <a href={`#${f.id}`} class="rounded-full px-4 py-2 text-sm font-extrabold bg-sr-action text-sr-action-ink hover:brightness-95">{f.label}</a>
        ) : (
          <span class="rounded-full px-4 py-2 text-sm font-extrabold bg-sr-track text-sr-muted">
            {f.label}<span class="ml-1.5 text-[11px] font-bold opacity-80">coming soon</span>
          </span>
        )
      ))}
    </nav>

    <!-- The site's own sets: free -->
    <section id="choir" class="flex flex-col gap-4 scroll-mt-24">
      <div>
        <h2 class="font-display text-2xl font-bold text-sr-ink">Choir and voice</h2>
        <p class="text-sr-ink-2">Free with any account, or none. abcStepByStep is on until you choose.</p>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {BUILTIN_SETS.map((s) => (
          <article class={`rounded-[28px] p-6 flex flex-col gap-4 ${TRACK_COLOR_CLASS[s.color]}`}>
            <div>
              <p class="text-xs font-extrabold uppercase tracking-widest opacity-75">{s.level}</p>
              <h3 class="font-display text-3xl font-bold">{s.name}</h3>
            </div>
            <p class="text-sm leading-relaxed">{s.blurb}</p>
            <dl class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 text-sm">
              {s.facts.map(([k, v]) => (<><dt class="font-bold opacity-75">{k}</dt><dd>{v}</dd></>))}
            </dl>
            <div class="mt-auto pt-2 border-t border-current/15">
              <TrackSubscribe client:only="svelte" trackId={s.id} tryHref={s.href} tryLabel="Try it" openHref={s.href.split("?")[0]} free />
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Instrument tracks: Pro -->
    {groups.map((g) => (
      <section id={g.id} class="flex flex-col gap-4 scroll-mt-24">
        <div>
          <h2 class="font-display text-2xl font-bold text-sr-ink">{g.title} <span class="ml-1 align-middle text-xs font-extrabold rounded-full bg-sr-action text-sr-action-ink px-2.5 py-1">Pro</span></h2>
          <p class="text-sr-ink-2">{g.note}</p>
        </div>
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {g.tracks.map((t) => (
            <article class={`rounded-[28px] p-6 flex flex-col gap-4 ${TRACK_COLOR_CLASS[t.color]}`}>
              <div class="flex items-start justify-between gap-3">
                <div>
                  <p class="text-xs font-extrabold uppercase tracking-widest opacity-75">{t.level}</p>
                  <h3 class="font-display text-3xl font-bold">{t.name}</h3>
                </div>
                <InstrumentIcon instrument={iconFor(t)} />
              </div>
              <p class="text-sm leading-relaxed">{t.blurb}</p>
              <dl class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 text-sm">
                <dt class="font-bold opacity-75">Steps</dt><dd>{t.steps.length}, each a rhythm drill and notes</dd>
                <dt class="font-bold opacity-75">Reads</dt><dd>{({ treble: "Treble", bass: "Bass", alto: "Alto", tenor: "Tenor" })[t.clef]} clef, {trackKeys(t).join(", ")}</dd>
                <dt class="font-bold opacity-75">Range</dt><dd>{trackReach(t)}{t.transposeSemitones ? " written" : ""}</dd>
                <dt class="font-bold opacity-75">Sounds</dt><dd>{soundsLabel(t)}</dd>
              </dl>
              <div class="mt-auto flex flex-col gap-3 pt-2 border-t border-current/15">
                <TrackSubscribe client:only="svelte" trackId={t.id} tryHref={trackHref(t.steps[0].id, "rhythm")} />
                <a class="text-sm font-extrabold" href={`/curriculum/${t.id}`}>See all {t.steps.length} steps →</a>
              </div>
            </article>
          ))}
        </div>
      </section>
    ))}

    <!-- How a step works -->
    <section class="sr-panel bg-sr-raise p-6 sm:p-8 grid gap-6 lg:grid-cols-[1fr_1.3fr] items-start">
      <div class="flex flex-col gap-3">
        <h2 class="font-display text-2xl font-bold text-sr-ink">Rhythm runs two steps ahead</h2>
        <p class="text-sr-ink-2">
          A new rhythm arrives on its own, as a rhythm drill: clap it, count it, play it on one note. Notes only go on it
          {RHYTHM_LEAD} steps later, once it is old news. So a step never asks for a new rhythm and new notes at once.
        </p>
        <p class="text-sr-ink-2">
          When the rhythms are all learned, the notes catch up: the last steps put every rhythm and meter together on
          four keys and the whole range.
        </p>
      </div>
      <ol class="grid gap-2" aria-label="The first six steps of the trumpet track">
        <li class="grid grid-cols-[2.5rem_1fr_1fr] gap-2 text-[11px] font-extrabold uppercase tracking-wide text-sr-faint">
          <span>Step</span><span>Rhythm drill</span><span>Notes</span>
        </li>
        {demo.map((s) => (
          <li class="grid grid-cols-[2.5rem_1fr_1fr] gap-2 items-stretch">
            <span class="rounded-full w-8 h-8 self-center flex items-center justify-center bg-sr-track text-sr-ink-2 font-bold tabular-nums">{s.number}</span>
            <span class="rounded-2xl bg-sr-mint text-sr-mint-ink px-3 py-2 text-sm font-bold">{s.title}</span>
            {s.notes ? (
              <span class="rounded-2xl bg-sr-sky text-sr-sky-ink px-3 py-2 text-sm">
                <span class="font-bold">{s.newNotes}</span>
                <span class="block text-xs opacity-80">on step {s.number - RHYTHM_LEAD} rhythms and before</span>
              </span>
            ) : (
              <span class="rounded-2xl border-2 border-dashed border-sr-hairline px-3 py-2 text-xs text-sr-faint flex items-center">rhythm only, for now</span>
            )}
          </li>
        ))}
      </ol>
    </section>
  </div>
</Layout>
