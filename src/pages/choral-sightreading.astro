---
import Layout from "../layouts/Layout.astro";
import AbcjsChoral from "../components/AbcjsChoral.svelte";
import AppSkeleton from "../components/ui/AppSkeleton.astro";
---

<Layout
  title="Choral Sight-Reading Practice - SATB, SSA, TTB | abc Sight Reading"
  description="Generate unlimited choral sight-reading exercises in two, three and four parts - SATB, SSA, TTB and more - at UIL levels 1-5, with solfège, playback and printing."
  themable
>
  <div class="flex flex-col w-full h-full items-center justify-center">
    <h1 class="text-4xl font-bold mb-2">Choral Sight Reading Practice</h1>
    <p class="text-sr-muted text-sm mb-6 text-center max-w-xl">
      A new two-, three- or four-part exercise every time you press Generate - in your choir's key, voicing and level.
    </p>
    <AbcjsChoral client:only="svelte">
      <AppSkeleton slot="fallback" staves={4} rows={3} />
    </AbcjsChoral>
  </div>

  <section class="max-w-3xl mx-auto mt-16 text-sr-ink-2 flex flex-col gap-3 no-print">
    <h2 class="text-2xl font-semibold text-sr-ink">How to use it with a choir</h2>
    <p>
      Pick a voicing - four-part mixed (SATB), three-part treble (SSA), tenor-bass (TTB) and the two-part voicings the
      lower UIL levels use - then a UIL level, or set the key, meter, rhythms and chords yourself. Each part stays in
      its own range, the voice leading avoids parallel fifths and octaves, and eight bars come out as a real phrase with
      a cadence.
    </p>
    <p>
      Project it, print it, or play it back on piano or choir sound with a count-in and a moving cursor. Show movable-do
      or fixed-do solfège under each part, or Roman numerals above, on the exercise already on screen.
    </p>
    <p>
      Practising a single line or a rhythm first? <a class="underline text-sr-action-fg" href="/sightreading">Unison sight-singing</a>
      and rhythm-only drills are on the Unison page. Preparing for contest: <a class="underline text-sr-action-fg" href="/uil-sight-reading">UIL sight-reading practice</a>.
    </p>
  </section>
</Layout>
