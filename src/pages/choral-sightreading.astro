---
import Layout from "../layouts/Layout.astro";
import AbcjsChoral from "../components/AbcjsChoral.svelte";
import AppSkeleton from "../components/ui/AppSkeleton.astro";
---

<Layout
  title="Choral Sight-Reading Practice: SATB, SSA, TTB | abcSightReading"
  description="Generate unlimited choral sight-reading exercises in two, three and four parts (SATB, SSA, TTB and more) at UIL levels 1 to 5, with solfège, playback and printing."
  themable
>
  <div class="flex flex-col w-full h-full items-center justify-center">
    <h1 class="text-4xl font-bold mb-8">Choral Sight Reading Practice</h1>
    <AbcjsChoral client:only="svelte">
      <AppSkeleton slot="fallback" staves={4} rows={3} />
    </AbcjsChoral>
  </div>

</Layout>
