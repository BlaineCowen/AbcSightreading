---
import Layout from "../layouts/Layout.astro";
import AuthForm from "../components/AuthForm.svelte";
import { classlinkEnabled, googleEnabled } from "../lib/server/auth";
import { enabled as freeMonthOn, offerUntil } from "../lib/server/free-month";
import { serverEnv } from "../lib/server/env";

// The ClassLink button stays off the production login page until a real
// district has signed in with it (Blaine, 26 October 2026: only ClassLink's
// test district has). The LaunchPad tile, /classlink, still signs in.
const showClasslink = classlinkEnabled && serverEnv("VERCEL_ENV") !== "production";

const requested = Astro.url.searchParams.get("mode");
const mode = requested === "signup" || requested === "forgot" || requested === "student" ? requested : "signin";

// A code link (/account?code=X) sent here to sign in first: name the code, so
// the visitor knows it is waiting on the other side.
let code: string | null = null;
try {
  const next = new URL(Astro.url.searchParams.get("next") ?? "", Astro.url.origin);
  const raw = next.pathname === "/account" ? next.searchParams.get("code") : null;
  if (raw && /^[A-Za-z0-9-]{3,30}$/.test(raw)) code = raw.toUpperCase();
} catch {}
---

<Layout noindex title="Sign in | abcSightReading" themable>
  <div class="flex flex-col w-full items-center pt-2 pb-16">
    <AuthForm
      client:only="svelte"
      googleEnabled={googleEnabled}
      classlinkEnabled={showClasslink}
      mode={mode}
      freeMonth={freeMonthOn()}
      freeMonthUntil={offerUntil()}
      code={code}
    />
  </div>
</Layout>
