---
import Layout from "../layouts/Layout.astro";
import BadgeMedal from "../components/BadgeMedal.svelte";
import { currentUser } from "../lib/server/api";
import { isAdmin } from "../lib/server/admin";
import { myBadges, pointsClasses } from "../lib/server/points";
import { BADGE_TOTAL, LEVELLED, ONCE, TEACHER_BADGES, nextLevel } from "../lib/badges";

/**
 * A student's badges (badges.ts): the levelled ones with their progress to
 * the next level, the one-time skills and efforts (grey until earned), and
 * the ones their teacher gave. Drawn on the server: no script.
 */
const user = await currentUser(Astro.request);
if (!user) return Astro.redirect("/login?next=/badges");
Astro.response.headers.set("Cache-Control", "private, no-store");
const on = isAdmin(user) || (await pointsClasses(user.id)).length > 0;
const data = on ? await myBadges(user.id) : null;

const levelOf = (id: string) => Math.max(0, ...(data?.badges.filter((b) => b.badgeId === id && !b.given).map((b) => b.level) ?? []));
const earnedCount = data ? data.badges.filter((b) => !b.given).length : 0;
const levelled = (group: string) =>
  LEVELLED.filter((b) => b.group === group).map((b) => {
    const level = levelOf(b.id);
    const next = data ? nextLevel(b, data.stats) : null;
    const unit = b.unit ?? ((n: number) => String(n));
    return {
      b, level,
      says: b.says(b.levels[Math.max(0, level - 1)]),
      bar: next ? Math.round((Math.min(next.have, next.need) / next.need) * 100) : 100,
      progress: next ? (level ? `${unit(next.have)} of ${unit(next.need)} for level ${next.level}` : `${unit(next.have)} of ${unit(next.need)}`) : "Every level earned",
    };
  });
const once = (group: string) => ONCE.filter((b) => b.group === group).map((b) => ({ b, done: levelOf(b.id) > 0 }));
const given = (data?.badges.filter((b) => b.given) ?? []).map((g) => {
  const t = TEACHER_BADGES.find((x) => x.id === g.badgeId);
  return { name: g.title || t?.name || "A badge", icon: t?.icon ?? "award", colour: t?.colour ?? "tint", when: new Date(g.earnedAt).toLocaleDateString("en-US", { month: "short", day: "numeric" }) };
});
---

<Layout title="Badges | abcSightReading" description="Your badges." noindex themable>
  <div class="w-full max-w-5xl mx-auto px-4 py-6 flex flex-col gap-6">
    <header class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <a class="sr-link text-sm" href="/">Home</a>
        <h1 class="text-3xl sm:text-4xl font-bold text-sr-ink">Badges</h1>
      </div>
      {data && <span class="count">{earnedCount} of {BADGE_TOTAL}</span>}
    </header>

    {!data ? (
      <p class="sr-panel p-5 text-sr-muted">Badges are coming soon.</p>
    ) : (
      <>
        <section>
          <h2 class="sect">Keep going</h2>
          <div class="grid">
            {levelled("keep-going").map((x) => (
              <div class="tile">
                <BadgeMedal icon={x.b.icon} colour={x.b.colour} level={x.level || null} locked={!x.level} />
                <div class="t">{x.b.name}</div>
                <div class="d">{x.says}</div>
                <div class="prog"><i style={`width:${x.bar}%`}></i></div>
                <div class="d">{x.progress}</div>
              </div>
            ))}
          </div>
        </section>
        <section>
          <h2 class="sect">Skills</h2>
          <div class="grid">
            {levelled("skills").map((x) => (
              <div class="tile">
                <BadgeMedal icon={x.b.icon} colour={x.b.colour} level={x.level || null} locked={!x.level} />
                <div class="t">{x.b.name}</div>
                <div class="d">{x.says}</div>
                <div class="prog"><i style={`width:${x.bar}%`}></i></div>
                <div class="d">{x.progress}</div>
              </div>
            ))}
            {once("skills").map((x) => (
              <div class="tile">
                <BadgeMedal icon={x.b.icon} colour={x.b.colour} locked={!x.done} />
                <div class="t">{x.b.name}</div>
                <div class="d">{x.b.says}</div>
              </div>
            ))}
          </div>
        </section>
        <section>
          <h2 class="sect">Effort</h2>
          <div class="grid">
            {once("effort").map((x) => (
              <div class="tile">
                <BadgeMedal icon={x.b.icon} colour={x.b.colour} locked={!x.done} />
                <div class="t">{x.b.name}</div>
                <div class="d">{x.b.says}</div>
              </div>
            ))}
          </div>
        </section>
        {given.length > 0 && (
          <section>
            <h2 class="sect">From your teacher</h2>
            <div class="grid">
              {given.map((g) => (
                <div class="tile">
                  <BadgeMedal icon={g.icon} colour={g.colour} />
                  <div class="t">{g.name}</div>
                  <div class="d">From your teacher, {g.when}</div>
                </div>
              ))}
            </div>
          </section>
        )}
      </>
    )}
  </div>
</Layout>

<style>
  .count { border-radius: 999px; padding: 4px 12px; font-weight: 800; font-size: 13px; background: var(--sr-tint); color: var(--sr-action-fg); }
  .sect { font-family: var(--sr-font-display); font-size: 1.15rem; font-weight: 700; color: var(--sr-ink); margin-bottom: 0.6rem; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr)); gap: 0.8rem; }
  .tile { background: var(--sr-raise); border: 1px solid var(--sr-hairline); border-radius: 22px; padding: 16px 10px 14px; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 7px; }
  .t { font-weight: 800; font-size: 14px; color: var(--sr-ink); }
  .d { font-size: 12px; color: var(--sr-muted); line-height: 1.3; }
  .prog { width: 100%; height: 7px; background: var(--sr-track); border-radius: 999px; overflow: hidden; }
  .prog i { display: block; height: 100%; background: var(--sr-action); }
</style>
