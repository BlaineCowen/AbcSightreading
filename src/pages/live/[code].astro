---
import Layout from "../../layouts/Layout.astro";
import LiveStudent from "../../components/LiveStudent.svelte";
import { isLiveCode, normalizeLiveCode } from "../../lib/live";

/**
 * A director's live room at its permanent address, the one on their QR
 * poster: the device shows the exercise while Live is on and waits while it
 * is off. Anyone may open it with no account, children included, so it
 * carries no analytics and no feedback form (childSafe).
 */
const raw = Astro.params.code ?? "";
const code = normalizeLiveCode(raw);
if (!isLiveCode(code)) return Astro.redirect("/live");
// One spelling of each address: 482-ktz and 482KTZ both land on /live/482KTZ.
if (raw !== code) return Astro.redirect(`/live/${code}`);
---

<Layout noindex childSafe title="Live practice | abcSightReading" description="Your director's exercise on your own device, with only your part." themable>
  <div class="flex flex-col w-full items-center gap-5 pb-16 max-w-5xl mx-auto">
    <LiveStudent client:only="svelte" initialCode={code} />
  </div>
</Layout>
