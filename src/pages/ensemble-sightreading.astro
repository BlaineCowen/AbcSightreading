---
import Layout from "../layouts/Layout.astro";
import AbcjsEnsemble from "../components/AbcjsEnsemble.svelte";
import AppSkeleton from "../components/ui/AppSkeleton.astro";
---

<Layout
  title="Ensemble Sight-Reading: Band, Orchestra and Choir Chorales | abcSightReading"
  description="Pick your instruments and voices and generate unlimited sight-reading chorales for them: every player on their own staff, in their own key and clef, with playback on each instrument."
  themable
>
  <div class="flex flex-col w-full h-full items-center justify-center">
    <h1 class="focus-hide text-2xl sm:text-3xl font-bold mb-3">Ensemble Sight Reading</h1>
    <AbcjsEnsemble client:only="svelte">
      <AppSkeleton slot="fallback" staves={4} rows={3} />
    </AbcjsEnsemble>
  </div>
</Layout>
