---
import Layout from "../layouts/Layout.astro";

/**
 * The landing page.
 *
 * One thing above the fold - start reading - and the case for the thing below
 * it, for anyone who scrolls. Every claim here is something the generator
 * actually does; see scripts/bach/README.md and the worklist for where the
 * harmony rules come from.
 *
 * Built from the same design system as the app pages (the sr-* tokens in
 * globals.css) and themable like them, so arriving here and pressing Start is
 * one look rather than two. It used to be hard-coded slate and blue, always
 * light, beside an app that follows dark mode.
 */

const features = [
  {
    title: "Fully customizable",
    body: "Key, time signature, voicing, measure count, tempo, which rhythms, which chords, how wide a leap each part may sing, how much decoration. Set it once and save it as a preset.",
  },
  {
    title: "Real voice leading, not noise",
    body: "Parallel fifths and octaves are ruled out as the parts are written. Chromatic notes are approached and left by step, and resolve the way they are altered. Melodic sevenths are refused, and every part stays inside its own range.",
  },
  {
    title: "Phrases, not just bars",
    body: "Eight measures come out as a period: a cadence at the midpoint, a consequent that answers the antecedent instead of repeating it, and phrase endings that breathe.",
  },
  {
    title: "Built for UIL",
    body: "Levels 1 to 5 with the UIL document's own keys, rhythms, voicings and ranges - including the two-part tenor-bass voicing the lower levels ask for.",
  },
  {
    title: "Hear it as well as read it",
    body: "Piano, organ, choir and more, with a count-in, a moving cursor and a loop. Transpose the playback without touching the page, so it is read in one key and heard in another.",
  },
  {
    title: "Solfège and analysis on tap",
    body: "Movable do, fixed do or note names under each part, and Roman numerals above the top staff, each switchable on the exercise already on screen. Print the clean copy.",
  },
];
---

<Layout
  title="ABC Sight Reading - Generate choral sight-reading exercises"
  description="Unlimited choral and unison sight-reading exercises, generated from real harmony rules. Fully programmatic. No AI."
  themable
>
  <div class="w-full max-w-5xl mx-auto px-2 md:px-4">
    <!-- Hero -->
    <section
      class="flex flex-col items-center justify-center text-center min-h-[calc(100vh-12rem)] px-2"
    >
      <p class="sr-label">Choral &amp; unison sight-reading</p>
      <!-- The navbar's logo at hero size, in the same proportions: "abc" in
           the favicon's Edwin Bold Italic at 0.7 of the name, as outlines
           (see Navbar.svelte for why). The name is read out whole. -->
      <h1
        class="mt-4 flex items-baseline justify-center gap-[0.13em] whitespace-nowrap text-[min(40px,11vw)] sm:text-6xl font-semibold tracking-[-0.015em] leading-none text-sr-ink"
      >
        <span class="sr-only">ABC</span>
        <svg
          class="h-[0.75em] w-auto text-[min(28px,7.7vw)] sm:text-[42px] text-sr-action-fg"
          viewBox="0 -736 1780 750"
          fill="currentColor"
          aria-hidden="true"
        ><path d="M440 -463 426 -416C402 -457 360 -477 301 -477C153 -477 15 -327 15 -166C15 -60 87 14 188 14C257 14 304 -11 351 -73C351 -51 351 -49 354 -41C363 -8 396 14 436 14C527 14 604 -85 646 -157L607 -181C570 -124 520 -70 503 -70C496 -70 489 -78 489 -86C489 -93 489 -94 499 -131L597 -463ZM334 -422C370 -422 395 -393 395 -350C395 -275 336 -56 239 -56C201 -56 178 -86 178 -135C178 -214 232 -422 334 -422ZM1018 -736 751 -722 744 -675H768C818 -675 830 -669 830 -644C830 -633 827 -623 814 -577L717 -251C696 -180 695 -177 695 -145C695 -49 776 14 899 14C981 14 1053 -14 1113 -70C1182 -133 1224 -223 1224 -306C1224 -404 1151 -478 1055 -478C1007 -478 973 -464 927 -426ZM997 -407C1034 -407 1061 -375 1061 -333C1061 -258 1000 -29 904 -29C865 -29 838 -60 838 -105C838 -155 864 -252 895 -315C925 -378 958 -407 997 -407ZM1684 -146C1625 -78 1577 -47 1528 -47C1480 -47 1446 -86 1446 -141C1446 -227 1497 -431 1609 -431C1634 -431 1651 -421 1651 -406C1651 -399 1648 -395 1639 -390C1611 -372 1601 -357 1601 -328C1601 -285 1633 -256 1679 -256C1731 -256 1765 -293 1765 -349C1765 -427 1698 -478 1594 -478C1424 -478 1281 -338 1281 -171C1281 -58 1362 14 1488 14C1576 14 1647 -26 1720 -116Z" /></svg>
        <span>Sight Reading</span>
      </h1>
      <p class="mt-5 max-w-2xl text-lg sm:text-xl text-sr-ink-2">
        Unlimited sight-reading exercises for your choir, generated from real
        harmony rules, in the key, level and voicing you actually need.
      </p>

      <div class="mt-10 flex flex-col items-center gap-4">
        <a href="/choral-sightreading" class="sr-btn px-8 py-3.5 text-base">
          Start Sight-Reading
        </a>
        <a
          href="/sightreading"
          class="text-sm text-sr-muted hover:text-sr-action-fg underline underline-offset-4"
        >
          or practice a single part
        </a>
      </div>

      <p class="sr-label mt-16">Scroll for what it does</p>
    </section>

    <!-- The pain -->
    <section class="py-20 px-2">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl sm:text-4xl font-bold text-sr-ink">
          Stop handwriting sight-reading exercises
        </h2>
        <p class="mt-6 text-lg text-sr-ink-2">
          Eight bars of correct four-part writing takes a working musician ten
          to twenty minutes, and your choir reads it once. Then you need another
          one, in a different key, at a different level, for a different
          voicing.
        </p>
        <p class="mt-4 text-lg text-sr-ink-2">
          Press Generate instead. Every exercise is new, and every one is
          singable.
        </p>
      </div>
    </section>

    <!-- The differentiator -->
    <section class="sr-panel py-16 px-6">
      <div class="max-w-3xl mx-auto text-center">
        <p class="sr-label text-sr-action-fg">How it works</p>
        <h2 class="mt-4 text-3xl sm:text-4xl font-bold text-sr-ink">
          Fully programmatic. No AI.
        </h2>
        <p class="mt-6 text-lg text-sr-ink-2">
          Every exercise is written the way a trained musician would write it:
          real chord progressions, sound voice leading, and melodies your
          singers can actually sing. Nothing is guessed, so nothing comes out
          strange.
        </p>
      </div>
    </section>

    <!-- Features -->
    <section class="py-20 px-2">
      <h2 class="text-3xl sm:text-4xl font-bold text-sr-ink text-center">
        What you get
      </h2>
      <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
        {
          features.map((f) => (
            <div class="sr-panel p-6">
              <h3 class="text-lg font-semibold text-sr-ink">{f.title}</h3>
              <p class="mt-3 text-sr-ink-2">{f.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Close -->
    <section class="py-20 px-2">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-3xl font-bold text-sr-ink">
          Your next exercise is one click away
        </h2>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
          <a href="/choral-sightreading" class="sr-btn px-8 py-3.5 text-base">
            Start Sight-Reading
          </a>
          <a href="/sightreading" class="sr-btn-quiet px-8 py-3.5 text-base">
            Single part
          </a>
        </div>
        <p class="mt-10 text-sm text-sr-faint">
          Rhythm-only drills and a rhythm game are in there too.
        </p>
      </div>
    </section>
  </div>
</Layout>
