---
import Layout from "../layouts/Layout.astro";
import JoinClass from "../components/JoinClass.svelte";
---

<Layout title="Join a class" description="Join your choir's class with its code" themable>
  <div class="flex flex-col w-full items-center gap-6 pb-16">
    <div class="text-center">
      <h1 class="text-3xl font-bold text-sr-ink">Join a class</h1>
      <p class="text-sr-muted mt-1">Type the code your teacher gave you.</p>
    </div>
    <JoinClass client:only="svelte" />
  </div>
</Layout>
