---
import Layout from "../layouts/Layout.astro";
import AccountPanel from "../components/AccountPanel.svelte";
import ClassProgress from "../components/ClassProgress.svelte";
import SyllableEditor from "../components/SyllableEditor.svelte";
import EducatorStudents from "../components/EducatorStudents.svelte";
import SchoolQuote from "../components/SchoolQuote.svelte";
import StudentAssignments from "../components/StudentAssignments.svelte";
import { currentUser } from "../lib/server/api";
import { accountTypeFor } from "../lib/server/students";
import { EDUCATOR_ON_SALE } from "../lib/plan";

// What this account is decides the page: an educator manages students; a
// student's teacher manages theirs, so none of the director's tools show.
const viewer = await currentUser(Astro.request).catch(() => null);
// From the database: the session cookie can be five minutes behind a purchase.
const accountType = viewer ? await accountTypeFor(viewer) : "standard";
---

<Layout noindex title="Account | abc Sight Reading" themable>
  <div class="flex flex-col w-full items-center gap-6 pb-16">
    <h1 class="text-3xl font-bold text-sr-ink">Account</h1>
    {accountType !== "educator" && <StudentAssignments client:only="svelte" />}
    <AccountPanel client:only="svelte" />
    {accountType !== "student" && <SchoolQuote client:only="svelte" educatorOnSale={EDUCATOR_ON_SALE} />}
    {accountType === "educator" && <EducatorStudents client:only="svelte" />}
    {accountType !== "student" && <ClassProgress client:only="svelte" />}
    {accountType !== "student" && <SyllableEditor client:only="svelte" />}
  </div>
</Layout>
