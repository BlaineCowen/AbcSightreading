---
/** A line drawing of a band instrument, in the text colour (for the curriculum cards). */
interface Props { instrument: string; size?: number; class?: string }
const { instrument: raw, size = 72, class: cls = "" } = Astro.props;
// Instruments that share a drawing.
const instrument = ({ oboe: "clarinet", euphonium: "tuba", "alto-sax": "sax", "tenor-sax": "sax", "bari-sax": "sax", viola: "violin", bass: "cello" } as Record<string, string>)[raw] ?? raw;
---
<svg width={size} height={size} viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class={cls} aria-hidden="true">
  {instrument === "trumpet" && (
    <g>
      <path d="M6 34h4" /><path d="M10 32.5v3" />
      <path d="M10 34h34" />
      <path d="M44 34c4 0 8-4 14-7v14c-6-3-10-7-14-7z" />
      <path d="M18 34v8a4 4 0 0 0 4 4h16a4 4 0 0 0 4-4v-8" />
      <rect x="22" y="22" width="4" height="12" rx="1.5" /><rect x="28" y="22" width="4" height="12" rx="1.5" /><rect x="34" y="22" width="4" height="12" rx="1.5" />
      <path d="M23 20h2M29 20h2M35 20h2" />
    </g>
  )}
  {instrument === "clarinet" && (
    <g>
      <path d="M14 8l4-2 4 4-2 4z" />
      <path d="M20 14l24 30" /><path d="M23 11l24 30" />
      <path d="M44 44c1 4 3 8 8 12M47 41c4 1 8 3 12 8" />
      <path d="M52 56c3-1 6-4 7-7" />
      <circle cx="28" cy="22" r="1.4" fill="currentColor" /><circle cx="32" cy="27" r="1.4" fill="currentColor" /><circle cx="36" cy="32" r="1.4" fill="currentColor" /><circle cx="40" cy="37" r="1.4" fill="currentColor" />
    </g>
  )}
  {instrument === "flute" && (
    <g>
      <path d="M6 36l50-14" /><path d="M7 40l50-14" />
      <ellipse cx="14" cy="36" rx="2" ry="1.4" />
      <circle cx="26" cy="31.5" r="1.5" fill="currentColor" /><circle cx="32" cy="29.8" r="1.5" fill="currentColor" /><circle cx="38" cy="28.1" r="1.5" fill="currentColor" /><circle cx="46" cy="25.8" r="1.5" fill="currentColor" />
    </g>
  )}
  {instrument === "bassoon" && (
    <g>
      <rect x="28" y="10" width="8" height="46" rx="3" />
      <path d="M36 50h4v-30" />
      <path d="M28 22c-6 0-10-4-12-10l-4 2" />
      <circle cx="32" cy="30" r="1.4" fill="currentColor" /><circle cx="32" cy="36" r="1.4" fill="currentColor" /><circle cx="32" cy="42" r="1.4" fill="currentColor" />
    </g>
  )}
  {instrument === "sax" && (
    <g>
      <path d="M22 6l6 2" />
      <path d="M28 8c4 2 6 6 6 10v26c0 6 4 10 10 10s10-4 10-10v-8" />
      <path d="M48 36h10" />
      <circle cx="34" cy="24" r="1.5" fill="currentColor" /><circle cx="34" cy="31" r="1.5" fill="currentColor" /><circle cx="34" cy="38" r="1.5" fill="currentColor" />
    </g>
  )}
  {instrument === "horn" && (
    <g>
      <circle cx="28" cy="34" r="14" /><circle cx="28" cy="34" r="8" />
      <path d="M40 26c6-4 10-10 18-12v18c-8-2-12-4-18-6" />
      <path d="M14 34H6" /><path d="M6 32v4" />
    </g>
  )}
  {instrument === "trombone" && (
    <g>
      <path d="M4 26h40" /><path d="M4 38h40" /><path d="M4 26v12" />
      <path d="M44 26c4 0 8-6 16-8v28c-8-2-12-8-16-8" />
      <path d="M20 26v-8h14" />
    </g>
  )}
  {instrument === "violin" && (
    <g>
      <path d="M24 30c-6 2-8 8-6 14 2 7 10 12 14 12s12-5 14-12c2-6 0-12-6-14 3-4 2-10-2-12-3-2-6-1-6-1s-3-1-6 1c-4 2-5 8-2 12z" />
      <path d="M29 4h6" /><path d="M30.5 4v48M33.5 4v48" />
      <path d="M24 38c1.5 2 1.5 5 0 7M40 38c-1.5 2-1.5 5 0 7" />
    </g>
  )}
  {instrument === "cello" && (
    <g>
      <path d="M23 28c-7 2-9 9-7 16 2 8 10 12 16 12s14-4 16-12c2-7 0-14-7-16 3-5 1-11-3-13-3-1-6 0-6 0s-3-1-6 0c-4 2-6 8-3 13z" />
      <path d="M30.5 3v50M33.5 3v50" /><path d="M32 56v6" />
      <path d="M22 38c1.5 2 1.5 5 0 7M42 38c-1.5 2-1.5 5 0 7" />
    </g>
  )}
  {instrument === "tuba" && (
    <g>
      <path d="M22 6h20" />
      <path d="M24 6c0 6 2 9 2 14v18" /><path d="M40 6c0 6-2 9-2 14v18" />
      <path d="M26 38c-6 0-10 4-10 10s5 10 16 10 16-4 16-10-4-10-10-10" />
      <rect x="28" y="24" width="3" height="10" rx="1.2" /><rect x="33" y="24" width="3" height="10" rx="1.2" />
      <path d="M12 46c-4 0-6-2-6-5" /><path d="M5 41h3" />
    </g>
  )}
</svg>
