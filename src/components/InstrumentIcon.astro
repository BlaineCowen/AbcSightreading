---
import { INSTRUMENT_ICON, INSTRUMENT_PATHS } from "../lib/curriculum/instrument-icons";

/** An instrument's drawing (game-icons.net, CC BY 3.0), in the text colour, for the curriculum cards. */
interface Props { instrument: string; size?: number; class?: string }
const { instrument, size = 72, class: cls = "" } = Astro.props;
const pick = INSTRUMENT_ICON[instrument];
const paths = pick ? INSTRUMENT_PATHS[pick.icon] ?? [] : [];
---
{paths.length > 0 && (
  <svg width={size} height={size} viewBox="0 0 512 512" class={cls} aria-hidden="true">
    <g fill="currentColor" transform={pick?.upright ? "rotate(-38 256 256)" : undefined}>
      {paths.map((d) => <path d={d} />)}
    </g>
  </svg>
)}
