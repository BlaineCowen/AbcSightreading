---
import Layout from "../layouts/Layout.astro";
import { PLAN_OFFERS } from "../lib/seo";
import { EDUCATOR_ON_SALE, GENERATION_LIMITS } from "../lib/plan";
// A real exercise from the generator (four bars, SATB, F major), drawn by
// abcjs once and saved, so the home page shows the product without loading
// the generator or spending a visitor's free exercises.
import heroExercise from "../assets/hero-exercise.svg?raw";
import FreeMonthPromo from "../components/FreeMonthPromo.svelte";
import { enabled as freeMonthOn, offerUntil } from "../lib/server/free-month";

/**
 * The landing page.
 *
 * One thing above the fold - start reading - and the case for the thing below
 * it, for anyone who scrolls. Every claim here is something the generator
 * actually does; see scripts/bach/README.md and the worklist for where the
 * harmony rules come from.
 *
 * Built from the same design system as the app pages (the sr-* tokens in
 * globals.css) and themable like them, so arriving here and pressing Start is
 * one look rather than two. It used to be hard-coded slate and blue, always
 * light, beside an app that follows dark mode.
 */

const features = [
  {
    title: "Fully customizable",
    body: "Key, time signature, voicing, measure count, tempo, which rhythms, which chords, how wide a leap each part may sing, how much decoration. Set it once and save it as a preset.",
  },
  {
    title: "Real voice leading, not noise",
    body: "Parallel fifths and octaves are ruled out as the parts are written. Chromatic notes are approached and left by step, and resolve the way they are altered. Melodic sevenths are refused, and every part stays inside its own range.",
  },
  {
    title: "Phrases, not just bars",
    body: "Eight measures come out as a period: a cadence at the midpoint, a consequent that answers the antecedent instead of repeating it, and phrase endings that breathe.",
  },
  {
    title: "Built for UIL",
    body: "Levels 1 to 5 with the UIL document's own keys, rhythms, voicings and ranges, including the two-part tenor-bass voicing the lower levels ask for.",
  },
  {
    title: "Hear it as well as read it",
    body: "Piano, organ, choir and more, with a count-in, a moving cursor and a loop. Transpose the playback without touching the page, so it is read in one key and heard in another.",
  },
  {
    title: "Solfège and analysis on tap",
    body: "Movable do, fixed do or note names under each part, Kodály rhythm syllables (or the ones your group uses) and Roman numerals above the top staff, each switchable on the exercise already on screen. Print the clean copy.",
  },
];

const faq = [
  {
    q: "Is it free?",
    a: `Yes, to start: ${GENERATION_LIMITS.anonymous} exercises a month with no account, ${GENERATION_LIMITS.free} with a free account. Pro is unlimited for $19.99 a year${EDUCATOR_ON_SALE ? ", and Educator adds student accounts for $99 a year" : ""}.`,
  },
  {
    q: "What voicings does it write?",
    a: "Unison, two-part treble and tenor-bass, three-part mixed (SAB), treble (SSA) and tenor-bass (TTB), and four-part mixed (SATB).",
  },
  {
    q: "Does it follow the UIL sight-reading levels?",
    a: "Yes. Levels 1 to 5 use the keys, meters, rhythms, chords, voicings and lengths from UIL's choir sight-reading criteria. It is an independent tool, not made by UIL.",
  },
  {
    q: "Can my students practice at home?",
    a: EDUCATOR_ON_SALE
      ? "Yes. With an Educator plan your classes get join codes and up to 100 secure student accounts for all age groups. Assign practice, and see who opened it and how many minutes they spent."
      : "Anyone can practice at home today. The Educator plan is coming soon: class join codes, up to 100 secure student accounts for all age groups, and assignments with the minutes each student spent.",
  },
  {
    q: "Is it made with AI?",
    a: "No. Every exercise is written by rules (chord progressions, voice leading, ranges and phrase structure), so nothing is guessed and nothing comes out strange.",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "abcSightReading",
    url: Astro.site?.href,
    applicationCategory: "EducationalApplication",
    operatingSystem: "Any (web browser)",
    description:
      "Unlimited sight-reading and sight-singing exercises for choirs and other ensembles: SATB, SSA, TTB and unison, UIL levels 1 to 5, single-line reading in four clefs for instrumentalists, with solfège, playback and student accounts.",
    offers: PLAN_OFFERS.map((o) => ({
      "@type": "Offer",
      name: o.name,
      price: o.price,
      priceCurrency: "USD",
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<Layout
  title="abcSightReading | Sight-Reading for Choirs & Ensembles, UIL Levels 1–5"
  description="Unlimited sight-reading and sight-singing exercises for choirs and other ensembles: SATB, SSA, TTB and unison, UIL levels 1 to 5, single-line reading in four clefs for instrumentalists, with solfège, playback and student accounts. Free to start."
  themable
  jsonLd={jsonLd}
>
  <div class="w-full max-w-5xl mx-auto px-2 md:px-4">
    <!-- The free month of Pro, while it is on offer. This page is only for
         someone signed out, so the server knows what it says, and it is drawn
         with the page (asked for in the browser, it pushed the page down). -->
    <div class="pt-2"><FreeMonthPromo client:load variant="strip" initial={{ ok: false, signedIn: false, offer: freeMonthOn(), until: offerUntil() }} /></div>
    <!-- Hero: the pitch on the left, a real exercise on the right that counts
         itself in and plays through (a cursor sweep, CSS only). Stacked on a
         phone, the exercise under the buttons. -->
    <section
      class="grid lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] gap-10 lg:gap-14 items-center min-h-[calc(100vh-12rem)] py-8 px-2"
    >
      <div
        class="flex flex-col items-center lg:items-start text-center lg:text-left"
      >
        <p class="sr-label">Sight-reading practice for choirs &amp; ensembles</p>
        <!-- The navbar's logo at hero size, in the same proportions: "abc" in
             the favicon's Edwin Bold Italic at 0.7 of the name, as outlines
             (see Navbar.svelte for why). The name is read out whole. -->
        <h1
          class="mt-4 flex items-baseline gap-[0.04em] whitespace-nowrap text-[min(40px,11vw)] sm:text-6xl font-semibold tracking-[-0.005em] leading-none text-sr-ink"
        >
          <span class="sr-only">abcSightReading</span>
          <svg
            class="h-[0.75em] w-auto text-[min(28px,7.7vw)] sm:text-[42px] text-sr-action-fg"
            viewBox="0 -736 1780 750"
            fill="currentColor"
            aria-hidden="true"
            ><path
              d="M440 -463 426 -416C402 -457 360 -477 301 -477C153 -477 15 -327 15 -166C15 -60 87 14 188 14C257 14 304 -11 351 -73C351 -51 351 -49 354 -41C363 -8 396 14 436 14C527 14 604 -85 646 -157L607 -181C570 -124 520 -70 503 -70C496 -70 489 -78 489 -86C489 -93 489 -94 499 -131L597 -463ZM334 -422C370 -422 395 -393 395 -350C395 -275 336 -56 239 -56C201 -56 178 -86 178 -135C178 -214 232 -422 334 -422ZM1018 -736 751 -722 744 -675H768C818 -675 830 -669 830 -644C830 -633 827 -623 814 -577L717 -251C696 -180 695 -177 695 -145C695 -49 776 14 899 14C981 14 1053 -14 1113 -70C1182 -133 1224 -223 1224 -306C1224 -404 1151 -478 1055 -478C1007 -478 973 -464 927 -426ZM997 -407C1034 -407 1061 -375 1061 -333C1061 -258 1000 -29 904 -29C865 -29 838 -60 838 -105C838 -155 864 -252 895 -315C925 -378 958 -407 997 -407ZM1684 -146C1625 -78 1577 -47 1528 -47C1480 -47 1446 -86 1446 -141C1446 -227 1497 -431 1609 -431C1634 -431 1651 -421 1651 -406C1651 -399 1648 -395 1639 -390C1611 -372 1601 -357 1601 -328C1601 -285 1633 -256 1679 -256C1731 -256 1765 -293 1765 -349C1765 -427 1698 -478 1594 -478C1424 -478 1281 -338 1281 -171C1281 -58 1362 14 1488 14C1576 14 1647 -26 1720 -116Z"
            ></path></svg
          >
          <span aria-hidden="true">SightReading</span>
        </h1>
        <p class="mt-5 max-w-xl text-lg sm:text-xl text-sr-ink-2">
          Unlimited sight-reading exercises for your group, generated from real
          harmony rules, in the key, level and voicing you actually need.
        </p>
        <div class="mt-5 flex flex-wrap justify-center lg:justify-start gap-2">
          <span
            class="rounded-full bg-sr-mint text-sr-mint-ink px-3.5 py-1.5 text-sm font-extrabold"
            >SATB</span
          >
          <span
            class="rounded-full bg-sr-sky text-sr-sky-ink px-3.5 py-1.5 text-sm font-extrabold"
            >SSA</span
          >
          <span
            class="rounded-full bg-sr-peach text-sr-peach-ink px-3.5 py-1.5 text-sm font-extrabold"
            >TTB</span
          >
          <span
            class="rounded-full bg-sr-butter text-sr-butter-ink px-3.5 py-1.5 text-sm font-extrabold"
            >Unison</span
          >
          <span
            class="rounded-full bg-sr-tint text-sr-action-fg px-3.5 py-1.5 text-sm font-extrabold"
            >UIL levels 1 to 5</span
          >
        </div>

        <div class="mt-8 flex flex-col sm:flex-row items-center gap-3 sm:gap-5">
          <a href="/sightreading" class="sr-btn px-8 py-3.5 text-base whitespace-nowrap shrink-0">
            Start Sight-Reading
          </a>
          <a
            href="/choral-sightreading"
            class="text-sm font-bold text-sr-muted hover:text-sr-action-fg underline underline-offset-4"
          >
            or practice in parts: SATB, SSA, TTB
          </a>
        </div>
      </div>

      <figure class="hero-demo relative w-full max-w-xl mx-auto lg:max-w-none">
        <div class="sr-sheet relative p-5 sm:p-7 lg:rotate-[1.2deg]">
          <div class="relative">
            <Fragment set:html={heroExercise} />
            <div class="hero-track" aria-hidden="true">
              <span class="hero-cursor"></span>
            </div>
          </div>
        </div>
        <div class="hero-countin" aria-hidden="true">
          <span>1</span><span>2</span><span>Ready</span><span>Go</span>
        </div>
        <figcaption class="mt-4 text-center text-sm font-bold text-sr-muted">
          A real exercise. Yours will be a new one.
        </figcaption>
      </figure>
    </section>

    <!-- The pain -->
    <section class="py-20 px-2">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl sm:text-4xl font-bold text-sr-ink">
          Stop handwriting sight-reading exercises
        </h2>
        <p class="mt-6 text-lg text-sr-ink-2">
          Eight bars of correct four-part writing takes a working musician ten
          to twenty minutes, and your group reads it once. Then you need another
          one, in a different key, at a different level, for a different
          voicing.
        </p>
        <p class="mt-4 text-lg text-sr-ink-2">
          Press Generate instead. Every exercise is new, and every one is
          singable.
        </p>
      </div>
    </section>

    <!-- The differentiator -->
    <section class="sr-panel py-16 px-6">
      <div class="max-w-3xl mx-auto text-center">
        <p class="sr-label text-sr-action-fg">How it works</p>
        <h2 class="mt-4 text-3xl sm:text-4xl font-bold text-sr-ink">
          Fully programmatic. No AI.
        </h2>
        <p class="mt-6 text-lg text-sr-ink-2">
          Every exercise is written the way a trained musician would write it:
          real chord progressions, sound voice leading, and melodies your
          singers can actually sing. Nothing is guessed, so nothing comes out
          strange.
        </p>
      </div>
    </section>

    <!-- Features -->
    <section class="py-20 px-2">
      <h2 class="text-3xl sm:text-4xl font-bold text-sr-ink text-center">
        What you get
      </h2>
      <div
        class="sr-pastels mt-12 grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6"
      >
        {
          features.map((f) => (
            <div class="sr-panel p-6">
              <h3 class="text-lg font-semibold text-sr-ink">{f.title}</h3>
              <p class="mt-3 text-sr-ink-2">{f.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Students -->
    <section class="sr-panel py-16 px-6">
      <div class="max-w-3xl mx-auto text-center">
        <p class="sr-label text-sr-action-fg">
          For your students, too{EDUCATOR_ON_SALE ? "" : " (coming soon)"}
        </p>
        <h2 class="mt-4 text-3xl sm:text-4xl font-bold text-sr-ink">
          Practice that happens at home
        </h2>
        <p class="mt-6 text-lg text-sr-ink-2">
          Give each class a join code, or make accounts from your roster: secure
          student accounts for all age groups. Assign a level for fifteen
          minutes, and see who opened it and how long they really practiced.
        </p>
        <p class="mt-4 text-sr-ink-2">
          Free to start. Unlimited for $19.99 a year{
            EDUCATOR_ON_SALE
              ? "; $99 a year with 100 student accounts"
              : ". Student accounts come with the Educator plan, coming soon"
          }.
          <a class="underline text-sr-action-fg" href="/pricing">See pricing</a>
        </p>
      </div>
    </section>

    <!-- Questions -->
    <section class="py-20 px-2">
      <h2 class="text-3xl sm:text-4xl font-bold text-sr-ink text-center">
        Questions
      </h2>
      <div class="mt-10 max-w-3xl mx-auto flex flex-col gap-6">
        {
          faq.map((f) => (
            <div>
              <h3 class="text-lg font-semibold text-sr-ink">{f.q}</h3>
              <p class="mt-2 text-sr-ink-2">{f.a}</p>
            </div>
          ))
        }
      </div>
      <p class="mt-8 text-center text-sr-muted">
        Preparing for contest? <a
          class="underline text-sr-action-fg"
          href="/uil-sight-reading">UIL sight-reading practice</a
        >. Choosing a tool for your group? <a
          class="underline text-sr-action-fg"
          href="/why-abc-sight-reading">Why abcSightReading</a
        >.
      </p>
    </section>

    <!-- Close -->
    <section class="py-20 px-2">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-3xl font-bold text-sr-ink">
          Your next exercise is one click away
        </h2>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
          <a href="/sightreading" class="sr-btn px-8 py-3.5 text-base whitespace-nowrap shrink-0">
            Start Sight-Reading
          </a>
          <a href="/choral-sightreading" class="sr-btn-quiet px-8 py-3.5 text-base">
            Choral
          </a>
        </div>
        <p class="mt-10 text-sm text-sr-faint">
          Rhythm-only drills, counted in Kodály or 1 &amp; 2 &amp;, are on the
          <a class="underline hover:text-sr-action-fg" href="/sightreading">Unison</a> page.
        </p>
      </div>
    </section>
  </div>
</Layout>

<style>
  /* The hero's exercise plays itself on a loop: a one-bar count-in ("1, 2,
     Ready, Go" at 120, as the practice pages count 4/4), then a cursor
     through the four bars, then a breath. 11.5s in all. */
  .hero-demo :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  .hero-track {
    position: absolute;
    left: 28%;
    right: 3%;
    top: 5%;
    bottom: 4%;
    pointer-events: none;
  }
  .hero-cursor {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 3px;
    border-radius: 3px;
    background: var(--sr-action);
    opacity: 0;
    animation: hero-sweep 11.5s linear infinite;
  }
  @keyframes hero-sweep {
    0%,
    17.3% {
      left: 0;
      opacity: 0;
    }
    17.4% {
      left: 0;
      opacity: 0.9;
    }
    87% {
      left: 100%;
      opacity: 0.9;
    }
    88%,
    100% {
      left: 100%;
      opacity: 0;
    }
  }
  .hero-countin {
    position: absolute;
    left: -10px;
    top: -18px;
    min-width: 4.5em;
    height: 1.9em;
    font-family: var(--sr-font-display);
    font-weight: 700;
    font-size: 26px;
    transform: rotate(-4deg);
  }
  @media (max-width: 639px) {
    .hero-countin {
      font-size: 18px;
      left: -4px;
      top: -14px;
    }
  }
  .hero-countin span {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 0.7em;
    border-radius: 999px;
    background: var(--sr-countin-bg);
    color: var(--sr-countin-ink);
    box-shadow: 0 10px 24px -10px rgba(30, 70, 160, 0.6);
    opacity: 0;
    animation: hero-word 11.5s linear infinite;
  }
  .hero-countin span:nth-child(2) {
    animation-delay: 0.5s;
  }
  .hero-countin span:nth-child(3) {
    animation-delay: 1s;
  }
  .hero-countin span:nth-child(4) {
    animation-delay: 1.5s;
    color: var(--sr-countin-go);
  }
  @keyframes hero-word {
    0% {
      opacity: 1;
      transform: scale(1.12);
    }
    1.5% {
      transform: scale(1);
    }
    4.3% {
      opacity: 1;
    }
    4.35%,
    100% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-cursor,
    .hero-countin span {
      animation: none;
    }
    .hero-countin span:nth-child(3) {
      opacity: 1;
    }
  }
</style>
