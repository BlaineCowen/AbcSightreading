---
interface Props {
  title: string;
  body: string;
  href: string;
}

const { href, title, body } = Astro.props;
---

<a href={href} class="group">
  <div
    class="relative p-6 bg-white rounded-xl shadow-lg transition-all duration-300 hover:shadow-xl hover:-translate-y-1"
  >
    <h2
      class="text-2xl font-bold mb-3 text-gray-800 group-hover:text-blue-600 transition-colors"
    >
      {title}
      <span
        class="inline-block transition-transform duration-300 group-hover:translate-x-1"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14" /><path d="m12 5 7 7-7 7" />
        </svg>
      </span>
    </h2>
    <p class="text-gray-600">
      {body}
    </p>
  </div>
</a>
