---
import Navbar from "../components/Navbar.svelte";
import FeedbackButton from "../components/FeedbackButton.svelte";
import { readFeedbackEmail } from "../lib/feedback-email";
import "../styles/globals.css";
import "abcjs/abcjs-audio.css";

interface Props {
  title: string;
  description?: string;
  /** Opt in to the dark theme. Only pages built on the --sr- tokens can. */
  themable?: boolean;
}

const {
  title,
  description = "A music sight reading practice app",
  themable = false,
} = Astro.props;

/**
 * Where tester feedback goes. Set PUBLIC_FEEDBACK_EMAIL to switch the button
 * on; with it unset there is no button, which is the right default for a
 * public build - an address written into the markup is an address that gets
 * scraped.
 *
 * Asked for at request time as well as build time - see readFeedbackEmail for
 * why, and for the five days of production with no button that prompted it.
 *
 * The runtime side reads the property off a variable rather than writing
 * `process.env.PUBLIC_FEEDBACK_EMAIL`, because Vite replaces that spelling at
 * build time too, which would make the fallback no fallback at all.
 */
const runtimeEnv: Record<string, string | undefined> =
  (globalThis as any).process?.env ?? {};
const feedbackEmail = readFeedbackEmail(
  runtimeEnv,
  import.meta.env.PUBLIC_FEEDBACK_EMAIL
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <!-- Before first paint, so a saved theme never flashes the other one.
         Nothing saved means no attribute, and the OS setting decides. -->
    <script is:inline>
      try {
        var t = localStorage.getItem("sr-theme");
        if (t === "dark" || t === "light") document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body class:list={["min-h-screen sr-desk", { "sr-themable": themable }]}>
    <header class="fixed top-0 w-full z-10">
      <Navbar client:only="svelte" />
    </header>
    <main class="container mx-auto px-4 pt-24">
      <slot />
    </main>
    {
      feedbackEmail && (
        <FeedbackButton client:idle to={feedbackEmail} page={title} />
      )
    }
  </body>
</html>
