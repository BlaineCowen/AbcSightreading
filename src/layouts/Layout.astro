---
import Navbar from "../components/Navbar.svelte";
import FeedbackButton from "../components/FeedbackButton.svelte";
import WelcomeNote from "../components/WelcomeNote.svelte";
import Analytics from "@vercel/analytics/astro";
import { readFeedbackEmail } from "../lib/feedback-email";
import { currentUser } from "../lib/server/api";
import { serverEnv } from "../lib/server/env";
import "../styles/globals.css";
import "abcjs/abcjs-audio.css";

interface Props {
  title: string;
  description?: string;
  /** Opt in to the dark theme. Only pages built on the --sr- tokens can. */
  themable?: boolean;
  /** Keep this page out of search results: accounts, sign-in, tools. */
  noindex?: boolean;
  /** Structured data (schema.org JSON-LD) for this page. */
  jsonLd?: object | object[];
}

const {
  title,
  description = "Unlimited choir sight-reading and sight-singing exercises in SATB, SSA, TTB and unison, UIL levels 1 to 5, with solfège and playback.",
  themable = false,
  noindex = false,
  jsonLd,
} = Astro.props;

/**
 * Search engines see one address per page: the canonical link names
 * www.abc-sightreading.com whichever domain served it. Previews and local dev
 * are never indexed.
 */
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const production = serverEnv("VERCEL_ENV") === "production";
const robots = noindex || !production ? "noindex, nofollow" : "index, follow";
// The version makes link previews that cached the old picture fetch this one.
const ogImage = new URL("/og.png?v=blue", Astro.site).href;

/**
 * A student account may belong to a child under 13. Nothing that watches or
 * reports goes on their pages: no analytics, and no feedback form (it emails
 * free text). COPPA's school-consent exception covers educational use only,
 * and Texas Education Code 32.152 bars using student data for anything else.
 */
const viewer = await currentUser(Astro.request).catch(() => null);
const isStudent = (viewer as { accountType?: string } | null)?.accountType === "student";

/**
 * Whether the Feedback button appears at all.
 *
 * The address itself stays on the server now - the panel posts its report to
 * /api/feedback and that route decides where it goes - so what this decides is
 * only whether feedback is switched on here. Unset means no button, which is
 * the right default: a button that cannot send anything is worse than none.
 *
 * Asked for at request time as well as build time. See readFeedbackEmail for
 * why, and for the failure it is guarding against.
 *
 * The runtime side reads the property off a variable rather than writing
 * `process.env.FEEDBACK_TO`, because Vite replaces that spelling at build time
 * too, which would make the fallback no fallback at all.
 */
const runtimeEnv: Record<string, string | undefined> =
  (globalThis as any).process?.env ?? {};
const feedbackConfigured = !!readFeedbackEmail(
  runtimeEnv,
  import.meta.env.FEEDBACK_TO ?? import.meta.env.PUBLIC_FEEDBACK_EMAIL
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#2f6fe0" />
    <link rel="manifest" href="/site.webmanifest" />
    <!-- Fredoka for headings, Nunito for everything else (globals.css). -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;500;600;700;800&display=swap"
    />
    <!-- The Analysis tool's IPA vowels, which Fredoka and Nunito lack: just
         those characters, a few hundred bytes. -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@600&text=%5B%5Di%C9%9B%C9%91ou&display=swap"
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="abc Sight Reading" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <!-- Before first paint, so a saved theme never flashes the other one.
         Nothing saved means no attribute, and the OS setting decides. -->
    <script is:inline>
      // Tone.js prints a banner to the console on load unless this is set.
      window.TONE_SILENCE_LOGGING = true;
      try {
        var t = localStorage.getItem("sr-theme");
        if (t === "dark" || t === "light") document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
    <!-- Vercel Web Analytics: page views, on every page (they all use this
         layout). Counts nothing locally - it only reports from a Vercel
         deployment - and needs no cookie. -->
    {!isStudent && <Analytics />}
  </head>
  <body class:list={["min-h-screen sr-desk", { "sr-themable": themable }]} data-feedback={feedbackConfigured && !isStudent ? "1" : undefined}>
    <header class="fixed top-0 w-full z-10">
      <Navbar client:only="svelte" />
      {!isStudent && <WelcomeNote client:only="svelte" />}
    </header>
    <main class="container mx-auto px-4 pt-24">
      <slot />
    </main>
    <!-- Plain links in the page's own HTML: the navbar is drawn in the
         browser, so without these a crawler finds no way between pages. -->
    <footer class="no-print mt-16 border-t border-sr-hairline py-8 px-4 text-sm text-sr-muted">
      <nav class="max-w-5xl mx-auto flex flex-wrap gap-x-6 gap-y-2 justify-center" aria-label="Site">
        <a class="hover:text-sr-action-fg" href="/choral-sightreading">Choral sight-reading</a>
        <a class="hover:text-sr-action-fg" href="/sightreading">Unison sight-reading</a>
        <a class="hover:text-sr-action-fg" href="/how-to-use">How to use</a>
        <a class="hover:text-sr-action-fg" href="/uil-sight-reading">UIL sight-reading practice</a>
        <a class="hover:text-sr-action-fg" href="/pricing">Pricing</a>
        <a class="hover:text-sr-action-fg" href="/tuner">abcTuner</a>
        <a class="hover:text-sr-action-fg" href="/sight-reading-factory-alternative">Compared with Sight Reading Factory</a>
      </nav>
    </footer>
    {
      feedbackConfigured && !isStudent && <FeedbackButton client:idle page={title} />
    }
  </body>
</html>
