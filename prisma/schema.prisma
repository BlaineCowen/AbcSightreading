// Accounts and the presets saved to them.
//
// user / session / account / verification / rateLimit are Better Auth's tables
// (src/lib/server/auth.ts) - their shape is Better Auth's to decide, so check
// `bunx @better-auth/cli generate` before changing them by hand. So is
// subscription, which Better Auth's Stripe plugin keeps in step with Stripe.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  /// Student sign-in name (Better Auth's username plugin): "ktz482.maria.g".
  username      String?   @unique
  /// "standard", "educator", or "student" (an account a teacher or a class
  /// code made, with no email - see src/lib/roster.ts).
  accountType   String    @default("standard")
  /// The Stripe customer, once they have been to checkout (the Stripe plugin).
  stripeCustomerId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  presets       Preset[]
  recentExercises RecentExercise[]
  classes       Class[]
  preference    UserPreference?
  enrollments   Enrollment[]
  seatGrants    SeatGrant[]
  usage         GenerationUsage[]
  quotes        Quote[]
  planNotices   PlanNotice[]
  freeMonth     FreeMonthClaim?
  practice      PracticeTime[]
  practiceClock PracticeClock?
  grants        AccessGrant[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

/// A named set of exercise settings. `store` is the list it belongs to - the
/// same key the page uses in localStorage (abcsr_presets for choral,
/// abcsr_unison_presets for unison) - so the lists never mix. `params` is
/// whatever that page saves; the page, not the database, knows its shape.
model Preset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  store     String
  name      String
  params    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  progress  ClassProgress[]

  @@index([userId, store])
  @@map("preset")
}

// A director's classes (choirs), and which presets each has passed. Progress
// is keyed by `presetKey` - "step:<ladder id>", "uil:UIL 3" or "saved:<preset
// id>" - so built-in presets, which have no row of their own, can be checked
// off too. A saved preset's key also sets `presetId`, so deleting the preset
// takes its checkmarks with it.
// The exercises a signed-in person generated most recently, for the home
// page (src/lib/recent-exercises.ts, /api/recent): the last MAX_RECENT, each
// a link that reopens that exact exercise with the settings it was shown in.
model RecentExercise {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "unison" or "choral": the page it opens on.
  page      String
  /// The preset it came from, or what kind of exercise it is.
  title     String
  /// What it is: "F major · 4/4 · 8 bars · do re mi".
  detail    String
  /// Path, query and #ex= fragment on this site: /sightreading?...#ex=...
  link      String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("recent_exercise")
}

model Class {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  position  Int             @default(0)
  /// What students type to join: "KTZ482" (shown KTZ-482). Educator classes only.
  joinCode  String?         @unique
  /// The course it follows (src/lib/class-course.ts): a set or instrument course id, or "own".
  course      String?
  /// Its own list of the course's steps as preset keys (hidden, reordered, presets added); null is the course as written.
  courseSteps Json?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  progress  ClassProgress[]
  enrollments Enrollment[]
  assignments Assignment[]

  @@index([userId])
  @@map("class")
}

model ClassProgress {
  id        String   @id @default(cuid())
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  presetKey String
  presetId  String?
  preset    Preset?  @relation(fields: [presetId], references: [id], onDelete: Cascade)
  passedAt  DateTime @default(now())

  @@unique([classId, presetKey])
  @@index([presetId])
  @@map("class_progress")
}

// Per-user settings that belong to the teacher rather than to one preset.
// `rhythmSyllables` is their own set of rhythm syllables (CustomSyllables in
// src/resources/rhythm-syllables.ts), or null for none.
model UserPreference {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rhythmSyllables Json?
  // What the preset menu offers: subscribed sets and tracks (src/lib/curriculum/catalogue.ts ids).
  // Null until the teacher chooses: then the default, abcStepByStep.
  curriculumTracks Json?
  // The teacher's own versions of track steps: { "track:<step id>:<rhythm|notes>": Unison options }
  trackOverrides  Json?
  updatedAt       DateTime @updatedAt

  @@map("user_preference")
}

// A student in a class. `managed` is true when the teacher's roster or the
// class code created the account - then the teacher may reset its password or
// delete it; a student who joined with their own account keeps control of it.
// Each distinct student across a teacher's classes uses one seat.
model Enrollment {
  id        String   @id @default(cuid())
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  managed   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([classId, studentId])
  @@index([studentId])
  @@map("enrollment")
}

// A yearly plan (Better Auth's Stripe plugin writes these from Stripe's
// webhooks). `referenceId` is the user's id; `plan` is "pro" or "educator".
// Which plan a user is on is decided in src/lib/plan.ts, not read from here.
model Subscription {
  id                   String    @id
  plan                 String
  referenceId          String
  stripeCustomerId     String?
  stripeSubscriptionId String?
  status               String    @default("incomplete")
  periodStart          DateTime?
  periodEnd            DateTime?
  trialStart           DateTime?
  trialEnd             DateTime?
  cancelAtPeriodEnd    Boolean?  @default(false)
  cancelAt             DateTime?
  canceledAt           DateTime?
  endedAt              DateTime?
  seats                Int?
  billingInterval      String?
  stripeScheduleId     String?

  @@index([referenceId])
  @@map("subscription")
}

// Student seats bought beyond the Educator plan's 100: a pack counts for a
// year from purchase. One row per Stripe checkout, so a repeated webhook
// cannot grant a pack twice.
model SeatGrant {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  seats             Int
  expiresAt         DateTime
  stripeCheckoutId  String?  @unique
  createdAt         DateTime @default(now())

  @@index([userId])
  @@map("seat_grant")
}

// Exercises generated by a signed-in account in a month ("2026-09"), for the
// free account's monthly allowance (src/lib/plan.ts). Counted on every plan,
// so it is also a record of use.
model GenerationUsage {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  month  String
  count  Int    @default(0)

  @@id([userId, month])
  @@map("generation_usage")
}

// A quote for a school's purchasing office: the Educator plan and any seat
// packs, made in Stripe (which numbers it and renders the PDF) for a Stripe
// customer that is the school - its billing contact, address and tax
// exemption - not the teacher. Accepted when the teacher enters the purchase
// order number; Stripe then invoices the school, net 30.
model Quote {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeQuoteId        String    @unique
  stripeCustomerId     String
  number               String?
  school               String
  contactEmail         String
  packs                Int       @default(0)
  taxExempt            Boolean   @default(false)
  /// Cents, as Stripe quoted it.
  amountTotal          Int
  status               String    @default("open")
  expiresAt            DateTime
  poNumber             String?
  acceptedAt           DateTime?
  stripeSubscriptionId String?
  invoiceUrl           String?
  /// "pro" or "educator".
  plan                 String    @default("educator")
  /// Where the quote was emailed, comma-separated (the teacher is copied).
  sendTo               String    @default("")
  /// The invoice being waited on: its id, due date, and when it was paid,
  /// reminded about, or left unpaid so the plan ended (/api/cron/po-invoices).
  invoiceId            String?
  invoiceDueAt         DateTime?
  paidAt               DateTime?
  remindedAt           DateTime?
  lapsedAt             DateTime?
  /// False: one year only (the plan ends at the end of the term, nothing is invoiced again). New quotes default to it.
  renews               Boolean   @default(true)
  createdAt            DateTime  @default(now())

  @@index([userId])
  @@map("quote")
}

// Practice set for a class: one preset and how many minutes, with an optional
// due date. The preset is copied in (`params`, for a saved preset) so editing
// or deleting it later does not change work already set. Rules:
// src/lib/practice.ts.
model Assignment {
  id        String         @id @default(cuid())
  classId   String
  class     Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  presetKey String
  /// What the student sees: "Step 12 · Do-re-mi-fa-so".
  title     String
  /// "unison" or "choral": the page it opens on.
  page      String
  /// A saved preset's settings as they were when assigned; null for steps and levels.
  params    Json?
  minutes   Int
  dueAt     DateTime?
  note      String         @default("")
  createdAt DateTime       @default(now())
  practice  PracticeTime[]

  @@index([classId])
  @@map("assignment")
}

// A student's practice, in seconds per day - on an assignment, or on their
// own when `assignmentId` is null. Several rows may share a day (two tabs
// racing to create one); every total is a sum, so that is harmless. Deleted
// after RETENTION_DAYS.
model PracticeTime {
  id           String      @id @default(cuid())
  studentId    String
  student      User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// The student's calendar day, "2026-09-28".
  day          String
  assignmentId String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  page         String
  seconds      Int         @default(0)
  exercises    Int         @default(0)
  updatedAt    DateTime    @updatedAt

  @@index([studentId, day])
  @@index([assignmentId])
  @@map("practice_time")
}

// When a student was last credited practice time, so reports from several
// tabs cannot count faster than the clock (creditSeconds).
model PracticeClock {
  studentId      String   @id
  student        User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lastCreditedAt DateTime

  @@map("practice_clock")
}

// A code that gives a plan free for `days` from the day it is used - the beta
// testers' Educator year. `maxUses` null is unlimited; `expiresAt` null never
// stops working. Rules: src/lib/codes.ts.
model AccessCode {
  id        String        @id @default(cuid())
  /// Upper case letters and digits: "BETA2026".
  code      String        @unique
  plan      String
  days      Int
  maxUses   Int?
  uses      Int           @default(0)
  expiresAt DateTime?
  note      String        @default("")
  createdAt DateTime      @default(now())
  grants    AccessGrant[]

  @@map("access_code")
}

// A plan an account holds from a code, until `expiresAt`. Read by planFor
// beside the account's subscriptions.
model AccessGrant {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeId    String?
  code      AccessCode? @relation(fields: [codeId], references: [id], onDelete: SetNull)
  plan      String
  expiresAt DateTime
  createdAt DateTime    @default(now())

  @@unique([userId, codeId])
  @@index([userId])
  @@map("access_grant")
}

// An advertiser's discount code: a Stripe coupon and promotion code, and
// their share of what each checkout using it paid.
model Affiliate {
  id                String          @id @default(cuid())
  name              String
  code              String          @unique
  percentOff        Int
  commissionPercent Int
  stripeCouponId    String
  stripePromotionId String          @unique
  active            Boolean         @default(true)
  createdAt         DateTime        @default(now())
  sales             AffiliateSale[]

  @@map("affiliate")
}

// One paid checkout that used an affiliate's code. Keyed by the checkout, so
// Stripe sending the event twice records it once. Paid out by hand;
// `paidOutAt` marks it done.
model AffiliateSale {
  id               String    @id @default(cuid())
  affiliateId      String
  affiliate        Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  stripeCheckoutId String    @unique
  /// What the customer paid before tax, in cents.
  amountPaid       Int
  commission       Int
  description      String
  paidOutAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([affiliateId])
  @@map("affiliate_sale")
}

/// A notice that a plan which will not renew is ending, sent once: `key` names
/// the plan and the term (subscription id or grant id, and its end date) and
/// how many days ahead (30 or 7). See src/lib/server/plan-ending.ts.
model PlanNotice {
  id     String   @id @default(cuid())
  userId String
  key    String   @unique
  sentAt DateTime @default(now())
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("plan_notice")
}

/// The free month of Pro (src/lib/free-month.ts), claimed once per person:
/// one per account, one per email key (the address with Gmail dots and
/// "+tags" folded away), and counted per browser and per network. The
/// browser and network are kept only as salted hashes.
model FreeMonthClaim {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailKey   String   @unique
  browserKey String?
  networkKey String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([browserKey])
  @@index([networkKey, createdAt])
  @@map("free_month_claim")
}
