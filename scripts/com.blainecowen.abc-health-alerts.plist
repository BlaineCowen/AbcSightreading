<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Runs scripts/health-alerts.ts every 5 minutes. Install:
     cp scripts/com.blainecowen.abc-health-alerts.plist ~/Library/LaunchAgents/ && launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.blainecowen.abc-health-alerts.plist
     PATH holds fnm's default Node, where the signed-in `vercel` CLI lives. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.blainecowen.abc-health-alerts</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/bun</string>
    <string>scripts/health-alerts.ts</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/Users/blainecowen/.local/share/fnm/aliases/default/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
  <key>WorkingDirectory</key><string>/Users/blainecowen/Projects/abcSightreading</string>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/tmp/abc-health-alerts.log</string>
  <key>StandardErrorPath</key><string>/tmp/abc-health-alerts.log</string>
</dict>
</plist>
