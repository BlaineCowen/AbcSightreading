<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Runs scripts/backup-db.sh nightly at 2 am. Install:
     cp scripts/com.blainecowen.abc-db-backup.plist ~/Library/LaunchAgents/ && launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.blainecowen.abc-db-backup.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.blainecowen.abc-db-backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/blainecowen/Projects/abcSightreading/scripts/backup-db.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>2</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/tmp/abc-db-backup.log</string>
  <key>StandardErrorPath</key><string>/tmp/abc-db-backup.log</string>
</dict>
</plist>
