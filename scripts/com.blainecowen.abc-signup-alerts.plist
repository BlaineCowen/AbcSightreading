<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Runs scripts/signup-alerts.ts every 15 minutes. Install:
     cp scripts/com.blainecowen.abc-signup-alerts.plist ~/Library/LaunchAgents/ && launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.blainecowen.abc-signup-alerts.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.blainecowen.abc-signup-alerts</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/bun</string>
    <string>scripts/signup-alerts.ts</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/blainecowen/Projects/abcSightreading</string>
  <key>StartInterval</key><integer>900</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/tmp/abc-signup-alerts.log</string>
  <key>StandardErrorPath</key><string>/tmp/abc-signup-alerts.log</string>
</dict>
</plist>
